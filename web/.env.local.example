# Firebase
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id

# 同意フォーム（/consent/[formId]）— サーバー側だけで使う。NEXT_PUBLIC_ を付けない。
# サービスアカウント鍵の JSON を 1 行で。Firebase コンソール → プロジェクトの設定 → サービス アカウント
FIREBASE_SERVICE_ACCOUNT_KEY=
# メール送信（NonTurn 本体と同じ SendGrid。info@non-turn.com が認証済みの送信者）
SENDGRID_API_KEY=
# メールに載せるギャラリーの URL。アプリのユニバーサルリンクと同じドメインにする。本番では必須
GALLERY_ORIGIN=https://gallery.non-turn.com
# 「まとめて送る」を呼べる管理画面の URL（CORS）。本番では必須
ADMIN_ORIGIN=
# 開発機でメールを送らずコンソールに出す（本番では効かない）
# MAIL_TRANSPORT=log
