rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    /**
     * 管理者判定は Firestore の users/{uid}.role を見る（クロスサービス参照）。
     *
     * Storage 側だけでは「アップロードしてよい人」を表現できない。以前の
     * 「認証済み かつ uid がパスと一致」では、web が匿名認証を有効にしている以上、
     * 誰でも signInAnonymously() → images/<自分のuid>/x に世界公開ファイルを
     * 置けた（2026-09-02 の監査 S1）。実際にアップロードするのは管理画面だけ。
     *
     * 制約: 参照できるのは既定データベースのみ、1 回の評価につき最大 2 ドキュメント。
     * ここでは 1 ドキュメントしか読まない。
     *
     * **本番では IAM の付与が必須。** クロスサービス参照は、Storage の
     * サービスエージェント service-<プロジェクト番号>@gcp-sa-firebasestorage
     * .iam.gserviceaccount.com が roles/firebaserules.firestoreServiceAgent を
     * 持っていないと評価時の Firestore 読み取りに失敗し、この関数は常に false に
     * なる（= 管理者のアップロードが全て storage/unauthorized で落ちる）。
     *
     * エミュレータには IAM 層が無いので rules-tests は付与の有無に関わらず通る。
     * **テストが通ったことを本番で動く根拠にしないこと。**
     *
     * firebase deploy は storage.rules に firestore.get を見つけると本来
     * 付与するか尋ねてくるが、非対話シェル（CI・エージェント経由）では無言で
     * スキップする。2026-09-03 にこれで本番のアップロードが停止した。
     * 手で付与する:
     *   gcloud projects add-iam-policy-binding <プロジェクトID> \
     *     --member=serviceAccount:service-<番号>@gcp-sa-firebasestorage.iam.gserviceaccount.com \
     *     --role=roles/firebaserules.firestoreServiceAgent
     */
    function isAdmin() {
      return isAuthenticated() &&
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isImageType() {
      return request.resource.contentType.matches('image/.*');
    }

    function isValidSize() {
      return request.resource.size < 50 * 1024 * 1024; // 50MB max
    }

    // Images folder
    match /images/{userId}/{imageId} {
      // 画像の配布は getDownloadURL のトークン付き URL で行っており、
      // その経路はルールを通らない。ここを公開にしておく理由が無いので閉じる。
      allow read: if isAuthenticated();
      allow create: if isAdmin() &&
                      request.auth.uid == userId &&
                      isImageType() &&
                      isValidSize();
      // 削除はアップロードした本人に限らない。別の管理者が案件ごと削除すると
      // uid が一致せず Storage の削除だけ失敗し、Firestore から storagePath が
      // 消えてファイルが回収不能になっていた（S2）。
      allow delete: if isAdmin();
    }

    // Thumbnails folder
    match /thumbnails/{userId}/{thumbnailId} {
      allow read: if isAuthenticated();
      allow create: if isAdmin() &&
                      request.auth.uid == userId &&
                      isImageType() &&
                      isValidSize();
      allow delete: if isAdmin();
    }

    // /profiles は 2026-09-02 に削除した。書き込む経路も読む経路も存在しない（H5）。
  }
}
