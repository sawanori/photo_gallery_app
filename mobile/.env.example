# ギャラリー web のオリジン。独自ドメイン確定後にここを差し替える。
EXPO_PUBLIC_WEB_ORIGIN=https://web-photo-gallery-app.vercel.app

# ユニバーサルリンク / App Links に使うホスト名。未指定なら WEB_ORIGIN のホストを使う。
# GALLERY_DOMAIN=gallery.non-turn.com

# ストアの識別子。未指定なら com.nonturn.photogallery。
# IOS_BUNDLE_ID=com.nonturn.photogallery
# ANDROID_PACKAGE=com.nonturn.photogallery
